# Machine-local source of truth (recommended):
#   $NORNIR_DOCKER_USER_ROOT/Run/sam2-dev/.env   (default root D:\Docker)
# Compose/Dev Containers still need a bridge at docker/.env (hardlink or copy of that file)
# so ${NORNIR_NET_MOUNTS_DIR_HOST} etc. substitute. Junctions cannot target files.
#
# Reuse existing Nornir path-B CIFS layout. Do not copy *.cred files into this repository.

NORNIR_NET_MOUNTS_DIR_HOST=D:\Docker\Run\nornir-dev\net-mounts
NORNIR_NET_CREDS_DIR_HOST=D:\Docker\Run\nornir-dev\secrets\net-creds

# Optional WSL UNC (Docker Desktop file sharing via the Ubuntu distro):
#NORNIR_NET_MOUNTS_DIR_HOST=\\wsl.localhost\Ubuntu\mnt\d\Docker\Run\nornir-dev\net-mounts
#NORNIR_NET_CREDS_DIR_HOST=\\wsl.localhost\Ubuntu\mnt\d\Docker\Run\nornir-dev\secrets\net-creds

# Per-modality values are NOT here. SAM2_MODALITY, SAM2_LOCAL_DATA_HOST (the fast local mirror
# mounted at /data-local; not a Windows folder), SAM2_OUTPUT_HOST and SAM2_CHECKPOINT_ROOT live in
# TEM.env / SEM.env (templates docker/example.TEM.env and docker/example.SEM.env, kept next to this
# file in D:\Docker\Run\sam2-dev\). Launch with -Modality TEM|SEM.

# Where the training data is read inside the container
SAM2_DATA_ROOT=/data-local/current

# Gallery process uid/gid. Must own ~/sam2-training so ignore/restore can move masks.
# Often 1000 for the WSL user. NET_BIND_SERVICE lets this uid bind ports 80 and 443.
SAM2_DATA_UID=1000
SAM2_DATA_GID=1000

# Host PEMs for gallery HTTPS (local fallback). Compose mounts SAM2_CERTS_HOST at /certs.
# Omit the files to serve HTTP only until Let's Encrypt enrolls (profile letsencrypt).
# Production: copy annotation-gallery/config-template/docker-env-template.txt to
# D:\Docker\Builds\AnnotationGallery\.env and use --profile letsencrypt (gallery.codepharm.net).
SAM2_CERTS_HOST=D:/Docker/mounted-configs/sam2-trainer
# Local publish defaults (compose): 8080:80 and 127.0.0.1:8443:443
#GALLERY_HTTP_PUBLISH=8080:80
#GALLERY_HTTPS_PUBLISH=127.0.0.1:8443:443
#GALLERY_HTTP_PUBLIC_PORT=8080
#GALLERY_HTTPS_PUBLIC_PORT=8443
# Prod example:
#GALLERY_HTTP_PUBLISH=80:80
#GALLERY_HTTPS_PUBLISH=443:443
#GALLERY_PUBLIC_HTTPS_ORIGIN=https://gallery.codepharm.net
#GALLERY_OIDC_REDIRECT_URI=https://gallery.codepharm.net/callback
#GALLERY_SSL_CERT_PATH=/etc/letsencrypt/live/gallery.codepharm.net/fullchain.pem
#GALLERY_SSL_KEY_PATH=/etc/letsencrypt/live/gallery.codepharm.net/privkey.pem
#LETSENCRYPT_EMAIL=you@example.com
#LETSENCRYPT_PRIMARY_DOMAIN=gallery.codepharm.net

# Read-only nornir-buildmanager checkout for gallery mask refresh.
# Default is the sibling checkout. A missing mount leaves masks unchanged.
#NORNIR_BUILDMANAGER_HOST=D:\src\git\nornir\nornir-buildmanager

# Bind source for /workspace (default: parent of docker/, i.e. this repo).
#SAM2_WORKSPACE_HOST=..

# Training crops: prefer /data-local (NVMe). NAS fallback:
#SAM2_DATA_ROOT=/storage4
SAM2_DATA_ROOT=/data-local/current

# Optional: override the default sam2.1_hiera_large.pt download.
#SAM2_CHECKPOINT_URL=https://dl.fbaipublicfiles.com/segment_anything_2/092824/sam2.1_hiera_large.pt

# Optional image build-arg (also documented in example.sam2-trainer-dev.build.env).
#SAM2_GIT_SHA=2b90b9f5ceec907a1c18123530e92e794ad901a4

# Nornir build dashboard broker (nornir-docker/start-dashboard.ps1). Defaults match nornir cursor-dev.
#NORNIR_MQTT_HOST=host.docker.internal
#NORNIR_MQTT_PORT=1883
#NORNIR_MQTT_ENABLE=1
# Sibling nornir-shared checkout, bind-mounted read-only at /opt/nornir-shared.
#NORNIR_SHARED_HOST=D:\src\git\nornir\nornir-shared

# Galleries (annotation-gallery-tem / -sem + gallery-router): both mirrors at once.
#SAM2_LOCAL_DATA_HOST_TEM=\\wsl.localhost\Ubuntu\home\<you>\sam2-training
#SAM2_LOCAL_DATA_HOST_SEM=\\wsl.localhost\Ubuntu\home\<you>\sam2-training-sem
# Required: long random string that signs the session cookies.
#GALLERY_SESSION_SECRET=
#GALLERY_TEM_OIDC_CLIENT_ID=
#GALLERY_TEM_OIDC_CLIENT_SECRET=
#GALLERY_SEM_OIDC_CLIENT_ID=
#GALLERY_SEM_OIDC_CLIENT_SECRET=
#GALLERY_REVIEW_PERMISSION=Annotate
