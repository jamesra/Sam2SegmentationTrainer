# SAM2 trainer: TEM settings. Layered over the shared .env by run-cursor-dev.ps1 / docker-build.ps1
# (-Modality TEM): docker compose --env-file docker/.env --env-file TEM.env ...
# Machine-local source: $NORNIR_DOCKER_USER_ROOT/Run/sam2-dev/TEM.env (default root D:\Docker).
# Only values that differ between TEM and SEM belong here; everything else stays in the shared .env.

SAM2_MODALITY=TEM

# WSL mirror bind-mounted at /data-local (fast local I/O, not a Windows folder).
# Filled by scripts/WSL/sync_training_data.sh.
SAM2_LOCAL_DATA_HOST=\\wsl.localhost\Ubuntu\home\jamesan\sam2-training

# Writable small artifacts (splits, pretrained download, TB pid) -> /outputs
SAM2_OUTPUT_HOST=D:/Docker/mounted-configs/sam2-trainer

# Large run checkpoints + TB events on the NAS CIFS mount (runs/<name> below this).
SAM2_CHECKPOINT_ROOT=/storage4/Sam2Trainer
