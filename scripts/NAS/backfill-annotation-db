#!/usr/bin/env python3
"""backfill-annotation-db: record each dataset's annotation database name without re-exporting.

The gallery matches Identity grants by the name Identity Server gives the annotation database (its AnnotationServer
resource, e.g. NM, cped, InferiorMonkey, TemporalMonkey, RC1). That is NOT the OData endpoint name in source.json
(NeitzNM, NeitzCPED, ...). This reads each volume's OData URL, finds the Identity AnnotationServer whose BaseUrl or
ExportUrl ends in the same segment, and writes its Name as "annotationDb" into <volume>/source.json and the "source"
block of <volume>/training_set.json. Nothing else in either file changes.

  backfill-annotation-db [--write] [--fix] [--identity-api URL] [ROOT ...]

--identity-api is the Identity database's Data API Builder (default http://localhost:3001/api, the dab-identity
container). Without it the OData segment is used, which only matches when Identity uses the same name (RC1, RC2, ...).
--fix replaces an annotationDb that is already present but different (the first version of this script wrote the OData name).

ROOT is a folder of training sets (default: ~/sam2-training, ~/sam2-training-sem, and the NAS
SAM2TrainingData/TEM and /SEM when mounted at /mnt/y). Without --write it only prints what it would do.
"""
import argparse
import json
import sys
import urllib.request
from pathlib import Path

DEFAULTS = [
    "~/sam2-training",
    "~/sam2-training-sem",
    "/mnt/y/SAM2TrainingData/TEM",
    "/mnt/y/SAM2TrainingData/SEM",
]


def db_name_from_odata(url):
    parts = [p for p in str(url or "").strip().rstrip("/").split("/") if p]
    if len(parts) >= 2 and parts[-1].lower() == "odata":
        return parts[-2]
    return ""


def identity_server_names(api):
    """{lower-case last segment of BaseUrl / ExportUrl: AnnotationServer name} from Identity's dbo_Resource table."""
    names = {}
    url = api.rstrip("/") + "/dbo_Resource?$first=1000"
    while url:
        with urllib.request.urlopen(url, timeout=20) as response:
            payload = json.load(response)
        for row in payload.get("value", []):
            if row.get("ResourceTypeId") != "AnnotationServer":
                continue
            for key in ("BaseUrl", "ExportUrl"):
                parts = [p for p in str(row.get(key) or "").rstrip("/").split("/") if p]
                if key == "ExportUrl" and parts and parts[-1].lower() == "export":
                    parts = parts[:-1]
                if parts:
                    names.setdefault(parts[-1].lower(), row["Name"])
        url = payload.get("nextLink")
    return names


def volume_dirs(root):
    """Yield every volume folder: <root>/<set>/<volume>, flat or with an AnnotationCrops folder."""
    for set_dir in sorted(root.iterdir()):
        if not set_dir.is_dir() or set_dir.is_symlink():  # skip the `current` link: same data as a set
            continue
        for volume in sorted(set_dir.iterdir()):
            if not volume.is_dir():
                continue
            nested = volume / "AnnotationCrops"
            yield set_dir.name, volume.name, nested if (nested / "source.json").is_file() else volume


def update(path, getter, setter, db, write, fix=False):
    """Add the field to a JSON file. Returns a short status."""
    if not path.is_file():
        return "-"
    doc = json.loads(path.read_text(encoding="utf-8"))
    current = getter(doc)
    if current == db:
        return "ok"
    if current and not fix:
        return f"DIFFERS({current})"
    setter(doc, db)
    if write:
        path.write_text(json.dumps(doc, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return "add"


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--write", action="store_true", help="write the changes (default: dry run)")
    ap.add_argument("--fix", action="store_true", help="replace an annotationDb that differs from the Identity name")
    ap.add_argument("--identity-api", default="http://localhost:3001/api", help="Identity Data API Builder base URL, or '' to skip")
    ap.add_argument("--folder-name-fallback", action="store_true",
                    help="when a volume has no OData URL, use its folder name (right for TEM: RC1, RC2, ...)")
    ap.add_argument("roots", nargs="*")
    args = ap.parse_args()
    roots = [Path(r).expanduser() for r in (args.roots or DEFAULTS)]
    identity = {}
    if args.identity_api:
        try:
            identity = identity_server_names(args.identity_api)
            print(f"# Identity annotation servers read from {args.identity_api}: {len(identity)} endpoint names", file=sys.stderr)
        except OSError as exc:
            print(f"# Identity not reachable at {args.identity_api} ({exc}); using OData names", file=sys.stderr)
    print(f"{'set':<22}{'volume':<18}{'annotationDb':<36}{'source.json':<14}training_set.json")
    for root in roots:
        if not root.is_dir():
            print(f"(skip {root}: not a folder)", file=sys.stderr)
            continue
        print(f"# {root}")
        for set_name, volume, folder in volume_dirs(root):
            source_path = folder / "source.json"
            if not source_path.is_file():
                continue
            doc = json.loads(source_path.read_text(encoding="utf-8"))
            odata_name = db_name_from_odata(doc.get("odata")) or (volume if args.folder_name_fallback else "")
            db = identity.get(odata_name.lower()) or ((str(doc.get("annotationDb") or "") or odata_name) if not identity else "")
            if identity and not db:
                print(f"{set_name:<22}{volume:<18}{'?':<36}no Identity annotation server for '{odata_name}'")
                continue
            if not db and args.folder_name_fallback:
                db = volume
            if not db:
                print(f"{set_name:<22}{volume:<18}{'?':<36}no odata URL; set annotationDb by hand")
                continue
            src = update(source_path, lambda d: d.get("annotationDb"), lambda d, v: d.__setitem__("annotationDb", v), db, args.write, args.fix)
            ts = update(
                folder / "training_set.json",
                lambda d: (d.get("source") or {}).get("annotationDb"),
                lambda d, v: d.setdefault("source", {}).__setitem__("annotationDb", v),
                db,
                args.write,
                args.fix,
            )
            print(f"{set_name:<22}{volume:<18}{db:<36}{src:<14}{ts}")
    if not args.write:
        print("\nDry run. Re-run with --write to apply.")


if __name__ == "__main__":
    main()
