{
  "name": "SAM2 trainer (cursor-dev + net mounts)",
  "dockerComposeFile": [
    "../docker/compose.cursor-dev.yaml",
    "${localEnv:NORNIR_DOCKER_USER_ROOT:D:\\Docker}/Run/sam2-dev/compose.net-mounts.override.yaml"
  ],
  "service": "cursor-dev",
  "workspaceFolder": "/workspace",
  "overrideCommand": false,
  "postAttachCommand": "SAM2_CURSOR_DEV_SETUP_ONLY=1 /usr/local/bin/cursor-dev-entry.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.languageServer": "Jedi"
      }
    }
  }
}
